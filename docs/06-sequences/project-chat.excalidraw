    {
      "id": "Y5N3jufAAdZgYeqF-VBbt",
      "type": "text",
      "x": 812.5910382798547,
      "y": 9969.53057979134,
      "width": 3570.057246777852,
      "height": 294.81230506001526,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
