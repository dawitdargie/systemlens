# GitHub Personal Access Token (recommended)
# Get one at https://github.com/settings/tokens
# Without this, unauthenticated GitHub API requests are limited to 60/hour
GITHUB_TOKEN=your_github_token_here

# Groq API Key (required for AI-powered understanding, explanations, and chat)
# Get one at https://console.groq.com
# (AI_API_KEY is an alias — if both are set, AI_API_KEY takes priority)
GROQ_API_KEY=your_groq_api_key_here

# AI model (optional — has a sensible default)
AI_MODEL=llama-3.3-70b-versatile

# Override the AI provider base URL (optional — defaults to Groq)
AI_BASE_URL=https://api.groq.com/openai/v1

# Set to "false" to disable disk-based analysis caching (optional — defaults to true)
CACHE_ANALYSIS=true
